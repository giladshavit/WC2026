{
  "expo": {
    "name": "Predicto",
    "slug": "predicto",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1f3c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.predictoapp.football",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "This helps us show you relevant ads and improve your Predicto experience."
      }
    },
    "android": {
      "newArchEnabled": false,
      "package": "com.predictoapp.football",
      "versionCode": 2,
      "enableProguardInReleaseBuilds": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a112d"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Predicto to save your bracket.",
          "saveToLibraryPermission": "Allow Predicto to save your bracket."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "blockedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO",
              "android.permission.READ_MEDIA_AUDIO",
              "android.permission.READ_EXTERNAL_STORAGE",
              "android.permission.ACCESS_MEDIA_LOCATION"
            ]
          }
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "1508136107625749",
          "clientToken": "960679422ad667db68f7a580a9fdc635",
          "displayName": "Predicto",
          "advertiserIDCollectionEnabled": false,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This helps us show you relevant ads and improve your Predicto experience."
        }
      ],
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "e223b6a7-7bfc-402c-955c-ff09aece2723"
      }
    },
    "owner": "giladshavit"
  }
}
